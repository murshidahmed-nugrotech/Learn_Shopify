<div
  class="custom-announcement-bar"
  style="
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
  "
>
  <div class="page-width">
    <div class="announcement-slider">
      {% for block in section.blocks %}
        <div class="announcement-item" {{ block.shopify_attributes }}>
          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              style="color: {{ section.settings.text_color }};"
            >
              {{ block.settings.text }}
            </a>
          {% else %}
            {{ block.settings.text }}
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if section.settings.show_close %}
      <button
        class="announcement-close"
        type="button"
        aria-label="Close announcement"
      >
        ×
      </button>
      <input type="text" id="search-box" placeholder="Search products">
      <div id="search-results"></div>
    {% endif %}
  </div>
</div>

<style>
  .custom-announcement-bar {
    position: relative;
    overflow: hidden;
    font-size: 14px;
    font-weight: 500;
  }

  .custom-announcement-bar .page-width {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 44px;
    position: relative;
  }

  .announcement-slider {
    width: 100%;
    text-align: center;
  }

  .announcement-item {
    display: none;
    padding: 12px 40px;
  }

  .announcement-item.active {
    display: block;
  }

  .announcement-item a {
    text-decoration: none;
  }

  .announcement-close {
    position: absolute;
    right: 0;
    background: none;
    border: none;
    color: inherit;
    font-size: 20px;
    cursor: pointer;
  }

  @media (max-width: 749px) {
    .announcement-item {
      padding: 12px 24px;
      font-size: 13px;
    }
  }
</style>

<script>
  document.addEventListener("DOMContentLoaded", function () {

    const bar = document.querySelector(".custom-announcement-bar");

    if (!bar) return;

    const items = bar.querySelectorAll(".announcement-item");

    if (items.length === 0) return;

    let index = 0;

    items[index].classList.add("active");

    {% if section.settings.autoplay %}
    setInterval(function () {
      items[index].classList.remove("active");
      index = (index + 1) % items.length;
      items[index].classList.add("active");
    }, {{ section.settings.speed | times: 1000 }});
    {% endif %}

    const closeBtn = bar.querySelector(".announcement-close");

    if (closeBtn) {
      closeBtn.addEventListener("click", function () {
        bar.style.display = "none";
      });
    }

  });

  // SEARCH BOX
const searchBox = document.querySelector("#search-box");
const searchResults = document.querySelector("#search-results");
let debounceTimer;

searchBox.addEventListener("input", (event) => {

  const keyword = event.target.value;

  clearTimeout(debounceTimer);

  debounceTimer = setTimeout(() => {

  fetch(`/search/suggest?q=${keyword}&section_id=predictive-search`)
    .then(response => response.text())
    .then(data => {
      searchResults.innerHTML = data;
    });
  }, 300);

});
</script>

{% schema %}
{
  "name": "Custom Announcement Bar",
  "max_blocks": 10,
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto Rotate",
      "default": true
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Rotation Speed (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show Close Button",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping on Orders Over ₹999"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free Shipping on Orders Over ₹999",
            "link": ""
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "New Arrivals Just Landed!",
            "link": ""
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Use Code WELCOME10 for 10% Off",
            "link": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
