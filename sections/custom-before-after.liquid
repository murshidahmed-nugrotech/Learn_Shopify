<section class="custom-before-after page-width">
  <div class="before-after-header">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p>{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="ba-wrapper">
    <div class="ba-image before-image">
      {% if section.settings.before_image != blank %}
        {{ section.settings.before_image | image_url: width: 2000 | image_tag: class: 'ba-img', loading: 'lazy' }}
      {% else %}
        <img
          src="{{ 'before.png' | asset_url }}"
          alt="Before"
          class="ba-img"
          loading="lazy"
          width="2000"
          height="2000"
        >
      {% endif %}

      <span class="ba-label before ">Before</span>
    </div>

    <div class="ba-image after-image">
      {% if section.settings.after_image != blank %}
        {{ section.settings.after_image | image_url: width: 2000 | image_tag: class: 'ba-img', loading: 'lazy' }}
      {% else %}
         <img
          src="{{ 'after.png' | asset_url }}"
          alt="Before"
          class="ba-img"
          loading="lazy"
          width="2000"
          height="2000"
        >
      {% endif %}

      <span class="ba-label after">After</span>
    </div>

    <input
      type="range"
      min="0"
      max="100"
      value="50"
      class="ba-slider"
    >

    <div class="ba-handle"></div>
  </div>
</section>

{% schema %}
{
  "name": "Before / After",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Before & After"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Drag the slider to compare the transformation."
    },
    {
      "type": "image_picker",
      "id": "before_image",
      "label": "Before Image"
    },
    {
      "type": "image_picker",
      "id": "after_image",
      "label": "After Image"
    }
  ],
  "presets": [
    {
      "name": "Custom Before / After"
    }
  ]
}
{% endschema %}
