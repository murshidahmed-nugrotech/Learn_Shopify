<section class="custom-faq page-width">

  <div class="faq-header">

    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p>{{ section.settings.subheading }}</p>
    {% endif %}

  </div>

  <div class="faq-wrapper">

    {% if section.blocks.size > 0 %}

      {% for block in section.blocks %}
        <div class="faq-item" {{ block.shopify_attributes }}>

          <button class="faq-question">
            <span>{{ block.settings.question }}</span>
            <span class="faq-icon">+</span>
          </button>

          <div class="faq-answer">
            <div class="faq-answer-inner">
              {{ block.settings.answer }}
            </div>
          </div>

        </div>
      {% endfor %}

    {% else %}

      {% assign questions = "What payment methods do you accept?|How long does shipping take?|Can I return my order?|How can I track my order?" | split: "|" %}

      {% assign answers = "We accept Visa, Mastercard, UPI and PayPal.|Shipping takes 3–7 business days.|Returns are accepted within 30 days.|Tracking details are sent via email after dispatch." | split: "|" %}

      {% for question in questions %}

        <div class="faq-item">

          <button class="faq-question">
            <span>{{ question }}</span>
            <span class="faq-icon">+</span>
          </button>

          <div class="faq-answer">
            <div class="faq-answer-inner">
              <p>{{ answers[forloop.index0] }}</p>
            </div>
          </div>

        </div>

      {% endfor %}

    {% endif %}

  </div>

</section>

{% schema %}
{
  "name": "Custom FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to know before placing an order."
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What payment methods do you accept?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We accept Visa, Mastercard, UPI, PayPal and major debit & credit cards.</p>"
        }
      ]
    }
  ],
  "presets": [
  {
    "name": "Custom FAQ",
    "blocks": [
      { "type": "faq" },
      { "type": "faq" },
      { "type": "faq" },
      { "type": "faq" }
    ]
  }
]
}
{% endschema %}
