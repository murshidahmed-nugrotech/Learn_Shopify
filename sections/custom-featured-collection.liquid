<section class="fc-section">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="fc-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    {% assign collection = section.settings.collection %}

     {% if collection != blank and collection.products_count > 0 %}
       <div class="fc-grid">
         {% for product in collection.products limit: section.settings.products %}
           <div class="fc-card">
             <a href="{{ product.url }}" class="fc-image">
               {% if product.featured_image %}
                 {{
                   product.featured_image
                   | image_url: width: 600
                   | image_tag: loading: 'lazy', class: 'fc-product-image'
                 }}
              {% else %}
                <img
                  src="{{ 'after.png' | asset_url }}"
                  alt="{{ product.title }}"
                  class="fc-product-image"
                  height=""
                  width=""
                >
              {% endif %}
            </a>

            <div class="fc-content">
              <h3>{{ product.title }}</h3>

              <p>
                {{ product.description | strip_html | truncate: 70 }}
              </p>

              <div class="fc-price">
                {{ product.price | money }}
              </div>

              <form method="post" action="/cart/add">
                <input
                  type="hidden"
                  name="id"
                  value="{{ product.selected_or_first_available_variant.id }}"
                >

                <button type="submit">Add to Cart</button>
              </form>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="fc-view-all">
        <a href="{{ collection.url }}"> View All Products </a>
      </div>

    {% else %}
      {% assign demo_titles = 'Classic T-Shirt,Premium Hoodie,Sport Shoes,Leather Bag' | split: ',' %}
      {% assign demo_prices = '₹999,₹1,999,₹2,499,₹3,499' | split: ',' %}

      <div class="fc-grid">
        {% for i in (1..4) %}
          <div class="fc-card">
            <a href="#" class="fc-image">
              <img
                src="{{ 'before.png' | asset_url }}"
                class="fc-product-image"
                height=""
                width=""
              >
            </a>

            <div class="fc-content">
              <h3>{{ demo_titles[forloop.index0] }}</h3>

              <p>Premium quality product designed for everyday comfort and style.</p>

              <div class="fc-price">
                {{ demo_prices[forloop.index0] }}
              </div>

              <button type="button">Add to Cart</button>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Custom Featured Collect",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products",
      "label": "Number of Products",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Custom Featured Collection"
    }
  ]
}
{% endschema %}
