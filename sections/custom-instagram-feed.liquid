<section class="custom-instagram-feed page-width">

    <div class="instagram-header">

        {% if section.settings.heading != blank %}
            <h2>{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.username != blank %}
            <p>@{{ section.settings.username }}</p>
        {% endif %}

    </div>

    <div class="instagram-grid">

        {% for block in section.blocks %}

            <a
                href="{{ section.settings.instagram_link }}"
                class="instagram-item"
                target="_blank"
                {{ block.shopify_attributes }}
            >

                {% if block.settings.image != blank %}

                    {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                        loading: 'lazy',
                        class: 'instagram-image'
                    }}

                {% endif %}

                <div class="instagram-overlay">

                    <span class="instagram-icon">

                        📷

                    </span>

                </div>

            </a>

        {% endfor %}

    </div>

    {% if section.settings.instagram_link != blank %}

        <div class="instagram-footer">

            <a
                href="{{ section.settings.instagram_link }}"
                class="instagram-button"
                target="_blank"
            >
                Follow @{{ section.settings.username }}
            </a>

        </div>

    {% endif %}

</section>

{% schema %}
{
    "name":"Custom Instagram Feed",
    "settings":[
        {
            "type":"text",
            "id":"heading",
            "label":"Heading",
            "default":"Follow Us On Instagram"
        },
        {
            "type":"text",
            "id":"username",
            "label":"Instagram Username",
            "default":"yourbrand"
        },
        {
            "type":"url",
            "id":"instagram_link",
            "label":"Instagram Profile Link"
        }
    ],
    "blocks":[
        {
            "type":"image",
            "name":"Instagram Image",
            "settings":[
                {
                    "type":"image_picker",
                    "id":"image",
                    "label":"Image"
                }
            ]
        }
    ],
    "presets":[
        {
            "name":"Custom Instagram Feed"
        }
    ]
}
{% endschema %}