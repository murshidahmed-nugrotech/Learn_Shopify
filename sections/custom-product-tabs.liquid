<section class="custom-product-tabs page-width">
  <div class="section-heading">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p>{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="tabs-nav">
    {% for block in section.blocks %}
      <button
        class="tab-button {% if forloop.first %}active{% endif %}"
        data-tab="tab-{{ block.id }}"
        {{ block.shopify_attributes }}
      >
        {{ block.settings.tab_title }}
      </button>
    {% endfor %}
  </div>

  {% for block in section.blocks %}
    {% assign collection = block.settings.collection %}

    <div
      class="tab-content {% if forloop.first %}active{% endif %}"
      id="tab-{{ block.id }}"
    >
      <div class="products-grid">
        {% if collection != blank and collection.products_count > 0 %}

  {% for product in collection.products limit: section.settings.products_to_show %}
    {% render 'custom-product-card', product: product %}
  {% endfor %}

{% else %}

  {% assign demo_titles = "Classic T-Shirt,Premium Hoodie,Sport Shoes,Leather Bag" | split: "," %}
  {% assign demo_prices = "₹999,₹1,999,₹2,499,₹3,499" | split: "," %}

  {% for i in (1..4) %}

    {% assign demo_image = 'before' %}

    {% if forloop.index == 2 or forloop.index == 4 %}
      {% assign demo_image = 'after' %}
    {% endif %}

    {% render 'custom-product-card',
      demo: true,
      title: demo_titles[forloop.index0],
      price: demo_prices[forloop.index0],
      image: demo_image
    %}

  {% endfor %}

{% endif %}
      </div>

      {% if collection != blank and collection.products_count > 0 and section.settings.show_view_all %}
        <div class="view-all-wrapper">
          <a href="{{ collection.url }}" class="button"> View All </a>
        </div>
      {% endif %}
    </div>
  {% endfor %}
</section>

{% schema %}
{
  "name": "Custom Product Tabs",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Products"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Browse products by category."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products Per Tab",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Product Tab",
      "settings": [
        {
          "type": "text",
          "id": "tab_title",
          "label": "Tab Title",
          "default": "Featured"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Product Tabs",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ]
}
{% endschema %}
