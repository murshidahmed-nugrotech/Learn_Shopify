<div
  class="cart-drawer-item"
  data-key="{{ item.key }}"
>

  <!-- ==========================================
       Product Image
  =========================================== -->

  <a
    href="{{ item.url }}"
    class="cart-item-image"
  >

    {% if item.image %}

      {{
        item.image
        | image_url: width: 160
        | image_tag:
          loading: 'lazy',
          class: 'cart-product-image'
      }}

    {% endif %}

  </a>

  <!-- ==========================================
       Product Details
  =========================================== -->

  <div class="cart-item-details">

    <a
      href="{{ item.url }}"
      class="cart-item-title"
    >
      {{ item.product.title }}
    </a>

    {% unless item.product.has_only_default_variant %}

      <p class="cart-item-variant">
        {{ item.variant.title }}
      </p>

    {% endunless %}

    <!-- Price -->

    <div class="cart-item-price">

      {% if item.original_line_price > item.final_line_price %}

        <span class="cart-item-price-sale">
          {{ item.final_line_price | money }}
        </span>

        <span class="cart-item-price-compare">
          {{ item.original_line_price | money }}
        </span>

      {% else %}

        <span class="cart-item-price-regular">
          {{ item.final_line_price | money }}
        </span>

      {% endif %}

    </div>

    <!-- Quantity -->

    <div class="cart-item-quantity">

      <button
        type="button"
        class="cart-qty-btn cart-qty-minus"
        data-key="{{ item.key }}"
      >
        −
      </button>

      <span
        class="cart-qty-value"
      >
        {{ item.quantity }}
      </span>

      <button
        type="button"
        class="cart-qty-btn cart-qty-plus"
        data-key="{{ item.key }}"
      >
        +
      </button>

    </div>

    <!-- Remove -->

    <button
      type="button"
      class="cart-item-remove"
      data-key="{{ item.key }}"
    >
      Remove
    </button>

  </div>

</div>