<div
  id="CartDrawerOverlay"
  class="cart-drawer-overlay"
  hidden
></div>

<aside
  id="CartDrawer"
  class="cart-drawer"
  aria-hidden="true"
  aria-labelledby="CartDrawerTitle"
  role="dialog"
>

  <!-- ==========================================
       Drawer Header
  =========================================== -->

  <div class="cart-drawer-header">

    <h2 id="CartDrawerTitle">
      Shopping Cart
    </h2>

    <button
      type="button"
      class="cart-drawer-close"
      aria-label="Close cart"
    >
      ×
    </button>

  </div>

  <!-- ==========================================
       Drawer Body
  =========================================== -->

  <div class="cart-drawer-body">

    <!-- Cart Items -->

    <div
      id="CartDrawerItems"
      class="cart-drawer-items"
    >

      <!--
        Items will be injected by cart-drawer.js
      -->

    </div>

    <!-- Empty Cart -->

    <div
      id="CartDrawerEmpty"
      class="cart-drawer-empty"
    >

      <div class="cart-empty-icon">
        🛒
      </div>

      <h3>Your cart is empty</h3>

      <p>
        Looks like you haven't added anything yet.
      </p>

      <a
        href="/collections/all"
        class="button button--primary"
      >
        Continue Shopping
      </a>

    </div>

  </div>

  <!-- ==========================================
       Drawer Footer
  =========================================== -->

  <div class="cart-drawer-footer">

    <div class="cart-subtotal">

      <span>Subtotal</span>

      <span id="CartDrawerSubtotal">
        {{ cart.total_price | money }}
      </span>

    </div>

    <p class="cart-note">

      Taxes and shipping calculated at checkout.

    </p>

    <div class="cart-actions">

      <a
        href="{{ routes.cart_url }}"
        class="button button--secondary"
      >
        View Cart
      </a>

      <button
        id="CartDrawerCheckout"
        class="button button--primary"
        onclick="location.href='{{ routes.checkout_url }}'"
      >
        Checkout
      </button>

    </div>

  </div>

</aside>